{
  "name": "signatureflow",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check && vite build && node scripts/release-version.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "postinstall": "node scripts/prepare-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "node --check src/main.js && node --check src/lib/detection-core.js && node --check src/lib/analyzer.js",
    "test:functions": "deno test --allow-env --allow-read --allow-net tests/functions.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.149",
    "signature_pad": "5.1.1",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.10",
    "@playwright/test": "1.56.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "deno": "2.5.6",
    "prettier": "3.6.2",
    "supabase": "2.122.1",
    "vite": "7.3.8",
    "vite-plugin-pwa": "1.0.3"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  }
}
